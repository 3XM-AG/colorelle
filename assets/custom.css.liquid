/*
/* base.css
*/
h1.banner__heading,
h2.banner__heading,
h3.banner__heading,
h4.banner__heading,
h5.banner__heading,
.h0.banner__heading,
.h1.banner__heading,
.h2.banner__heading,
.h3.banner__heading,
.h4.banner__heading,
.h5.banner__heading {
  font-family: var(--font-banner-family);
  font-style: var(--font-banner-style);
  font-weight: var(--font-banner-weight);
  letter-spacing: calc(var(--font-banner-scale) * 0.06rem);
  color: rgb(var(--color-foreground));
  line-height: calc(1 + 0.3 / max(1, var(--font-banner-scale)));
  word-break: break-word;
}

/*
/* componnents-facets.css
*/
.facets-container .product-count {
  display: none;
}

/*
/* section-image-banner.css
*/
.banner__box {
  border-radius: 5px;
  box-shadow: 0 20px 45px -4px #00000030;
}
@media screen and (min-width: 750px) {
  .banner__box {
    width: auto;
    max-width: 55rem;
    min-width: 45rem;
  }
}
@media screen and (min-width: 1400px) {
  .banner__box {
    max-width: 55rem;
  }
}

/*
/* section-multicolumn.css
*/
.multicolumn-card__image-wrapper--fourth-width {
  width: 25%;
}
.multicolumn__title {
  justify-content: center;
}

/*
/* template-collection.css
*/
.collection__title {
  text-align: center;
}